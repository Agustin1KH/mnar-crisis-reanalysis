# Raw data — do not commit (copyright, size)
data/raw/*
!data/raw/.gitkeep

# R session files
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/

# renv
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# Output — regenerate from scripts, don't version
output/tables/*
output/figures/*
!output/tables/.gitkeep
!output/figures/.gitkeep

# Sandbox handoff scratch (Python validation + task spec; not pipeline)
files (1)/

# Phase-2 per-shadow rendered outputs regenerate from the drivers +
# committed caches; only the headline stitched tables are force-added.
output/tables/phase2_shadow_*/
output/figures/phase2_shadow_*/

# OS cruft
.DS_Store
Thumbs.db
__MACOSX/
._*

# Editor
.vscode/
.idea/
*.swp
*~

# Memo build artifacts
memo/*.aux
memo/*.log
memo/*.out
memo/*.bbl
memo/*.blg
memo/*.toc
memo/*.synctex.gz
memo/*.fdb_latexmk
memo/*.fls
memo/*.xdv
